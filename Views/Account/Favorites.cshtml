@model List<FavoriteMovie>
@{
    ViewData["Title"] = "Yêu thích - LVDKMovie";

    string ImageUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "https://via.placeholder.com/320x480/111827/D4AF37?text=LVDK";
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return url;
        return $"https://img.ophim.live/uploads/movies/{url.TrimStart('/')}";
    }

    string ShortTitle(string title, int max = 24)
    {
        if (string.IsNullOrWhiteSpace(title) || title.Length <= max) return title;
        return title.Substring(0, max).TrimEnd() + "...";
    }
}

<style>
.favorites-shell {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 3.5rem;
}
.favorites-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
}
.favorites-mark {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(218,41,28,0.22);
    border: 1px solid rgba(212,175,55,0.35);
    font-size: 1.25rem;
}
.favorites-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
}
.favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 1rem;
}
.favorite-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
    background: #151a29;
    border: 1px solid rgba(255,255,255,0.07);
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s;
}
.favorite-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212,175,55,0.55);
}
.favorite-card img {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    display: block;
}
.favorite-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6,8,13,0.98) 0%, rgba(6,8,13,0.18) 55%, transparent 100%);
}
.favorite-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.85rem;
}
.favorite-name {
    color: #fff;
    font-size: 0.88rem;
    font-weight: 900;
    line-height: 1.25;
}
.favorite-year {
    display: inline-block;
    color: #ffd66b;
    margin-top: 0.35rem;
    font-size: 0.76rem;
    font-weight: 800;
}
.favorites-empty {
    color: var(--muted);
    background: #171c2c;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 3.5rem 1rem;
    text-align: center;
}
</style>

<div class="favorites-shell">
    <div class="favorites-head">
        <span class="favorites-mark" aria-hidden="true">&#9829;</span>
        <h1 class="favorites-title">Phim yêu thích</h1>
    </div>

    @if (Model.Any())
    {
        <div class="favorites-grid">
            @foreach (var movie in Model)
            {
                <a class="favorite-card" href="/phim/@movie.Slug">
                    <img src="@ImageUrl(string.IsNullOrWhiteSpace(movie.Thumb) ? movie.Poster : movie.Thumb)" alt="@movie.Title" loading="lazy" />
                    <span class="favorite-shade"></span>
                    <div class="favorite-info">
                        <div class="favorite-name">@ShortTitle(movie.Title)</div>
                        @if (movie.Year > 0)
                        {
                            <span class="favorite-year">@movie.Year</span>
                        }
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="favorites-empty">Bạn chưa ghim phim nào.</div>
    }
</div>
