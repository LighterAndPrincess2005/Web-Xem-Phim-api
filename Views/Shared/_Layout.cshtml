@using Microsoft.AspNetCore.Http
@{
    var displayName = Context.Session.GetString("DisplayName");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "LVDKMovie")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --neon: #D4AF37;
            --neon-dim: #a98725;
            --red: #DA291C;
            --red-dark: #8c1111;
            --bg: #070a10;
            --surface: #111827;
            --surface2: #171c2c;
            --text: #f8fafc;
            --muted: #8b98b7;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Urbanist', sans-serif;
            min-height: 100vh;
        }
        .neon { color: var(--neon); }
        .neon-border { border-color: var(--neon); }
        .neon-bg { background: var(--neon); color: #111; }
        nav {
            background: rgba(10,14,24,0.94);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            position: sticky;
            top: 0;
            z-index: 50;
        }
        .nav-inner {
            max-width: 1280px;
            height: 74px;
            margin: 0 auto;
            padding: 0 1.25rem;
            display: flex;
            align-items: center;
            gap: 2rem;
        }
        .logo-text {
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            color: #fff;
            font-size: 1rem;
            font-weight: 900;
            text-decoration: none;
        }
        .logo-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--red), #6d5dfc);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            box-shadow: 0 10px 28px rgba(218,41,28,0.28);
        }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.9rem;
            font-weight: 800;
        }
        .nav-links a {
            color: var(--muted);
            text-decoration: none;
            transition: color 0.2s, background 0.2s;
        }
        .nav-links a:hover { color: var(--neon); }
        .nav-links .active {
            color: #fff;
            background: #182033;
            padding: 0.62rem 0.9rem;
            border-radius: 8px;
        }
        .search-bar {
            width: 280px;
            background: #151b2b;
            border: 1px solid rgba(255,255,255,0.08);
            color: #fff;
            border-radius: 999px;
            padding: 10px 16px;
            font-family: 'Urbanist', sans-serif;
            font-size: 0.9rem;
            transition: border-color 0.2s;
        }
        .search-bar:focus {
            outline: none;
            border-color: var(--red);
        }
        .search-button {
            border: none;
            padding: 10px 16px;
            font-family: 'Urbanist', sans-serif;
            font-weight: 900;
            font-size: 0.82rem;
            cursor: pointer;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--red), var(--red-dark));
            color: #fff;
        }
        .account-link {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border: 1px solid rgba(212,175,55,0.26);
            border-radius: 999px;
            padding: 10px 14px;
            color: #fff;
            background: rgba(212,175,55,0.08);
            font-size: 0.85rem;
            font-weight: 900;
            text-decoration: none;
            white-space: nowrap;
        }
        .movie-card {
            position: relative;
            overflow: hidden;
            border-radius: 6px;
            aspect-ratio: 2/3;
            cursor: pointer;
            background: #151b2b;
            transition: transform 0.3s ease;
        }
        .movie-card:hover { transform: scale(1.03); }
        .movie-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .movie-card .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 55%);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .movie-card:hover .overlay { opacity: 1; }
        .movie-card .badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--neon);
            color: #111;
            font-size: 0.6rem;
            font-weight: 900;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
        }
        .movie-card .info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 12px 10px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .movie-card:hover .info { opacity: 1; }
        .movie-card .title {
            font-weight: 900;
            font-size: 0.85rem;
            line-height: 1.2;
            color: #fff;
        }
        .movie-card .sub {
            font-size: 0.72rem;
            color: var(--neon);
            margin-top: 3px;
        }
        .section-title {
            font-size: 1.3rem;
            font-weight: 900;
            letter-spacing: 0;
            text-transform: uppercase;
            color: #fff;
        }
        .section-title span { color: var(--neon); }
        footer {
            background: #070a10;
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 2rem 0;
            text-align: center;
            font-size: 0.8rem;
            color: var(--muted);
        }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #070a10; }
        ::-webkit-scrollbar-thumb { background: var(--red); border-radius: 999px; }
        @@media (max-width: 920px) {
            .nav-inner { gap: 1rem; flex-wrap: wrap; height: auto; padding-top: 0.85rem; padding-bottom: 0.85rem; }
            .nav-links { order: 3; width: 100%; overflow-x: auto; padding-bottom: 0.2rem; }
            .search-bar { width: min(48vw, 260px); }
        }
        @@media (max-width: 560px) {
            .nav-inner { align-items: stretch; }
            .nav-inner form { width: 100%; }
            .search-bar { width: 100%; }
        }
    </style>
</head>
<body>
<nav>
    <div class="nav-inner">
        <a href="/" class="logo-text">
            <span class="logo-mark">▶</span>
            <span><span style="color:var(--red);">LVDK</span><span style="color:var(--neon);">MOVIE</span></span>
        </a>
        <div class="nav-links">
            <a class="active" href="/">Trang chủ</a>
            <a href="/danh-sach/phim-moi-cap-nhat">Tất cả</a>
            <a href="/Home/TheLoai/hanh-dong">Thể loại</a>
            <a href="/Home/QuocGia/han-quoc">Quốc gia</a>
            <a href="/danh-sach/phim-moi-cap-nhat">Phim mới</a>
            <a href="/danh-sach/phim-bo">Phim bộ</a>
            <a href="/danh-sach/phim-le">Phim lẻ</a>
        </div>
        <div style="margin-left:auto;display:flex;align-items:center;gap:0.7rem;">
            <form method="get" action="/Home/Search" style="display:flex;gap:8px;">
                <input class="search-bar" name="keyword" placeholder="Tìm phim thuyết minh..." />
                <button type="submit" class="search-button">Tìm</button>
            </form>
            @if (string.IsNullOrWhiteSpace(displayName))
            {
                <a class="account-link" href="/Account/Login">Đăng nhập</a>
            }
            else
            {
                <a class="account-link" href="/Account/Logout">@displayName · Thoát</a>
            }
        </div>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer>
    <p>© 2026 <span class="neon">LVDKMovie</span> - Phim online thuyết minh, vietsub cập nhật mới.</p>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
