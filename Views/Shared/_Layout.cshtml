@using Microsoft.AspNetCore.Http
@{
    var displayName = Context.Session.GetString("DisplayName");
    var avatarUrl = Context.Session.GetString("AvatarUrl");
    if (string.IsNullOrWhiteSpace(displayName))
    {
        Context.Request.Cookies.TryGetValue("LVDKMovie.DisplayName", out displayName);
    }
    if (string.IsNullOrWhiteSpace(avatarUrl))
    {
        Context.Request.Cookies.TryGetValue("LVDKMovie.AvatarUrl", out avatarUrl);
    }
    if (string.IsNullOrWhiteSpace(avatarUrl))
    {
        avatarUrl = "/images/avatars/default-admin.jpg";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "LVDKMovie")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --neon: #D4AF37;
            --neon-dim: #a98725;
            --red: #DA291C;
            --red-dark: #8c1111;
            --bg: #070a10;
            --surface: #111827;
            --surface2: #171c2c;
            --text: #f8fafc;
            --muted: #8b98b7;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Urbanist', sans-serif;
            min-height: 100vh;
        }
        .neon { color: var(--neon); }
        .neon-border { border-color: var(--neon); }
        .neon-bg { background: var(--neon); color: #111; }
        nav {
            background: rgba(10,14,24,0.94);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            position: sticky;
            top: 0;
            z-index: 50;
        }
        .nav-inner {
            max-width: 1280px;
            height: 74px;
            margin: 0 auto;
            padding: 0 1.25rem;
            display: flex;
            align-items: center;
            gap: 2rem;
        }
        .logo-text {
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            color: #fff;
            font-size: 1rem;
            font-weight: 900;
            text-decoration: none;
        }
        .logo-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--red), #6d5dfc);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            box-shadow: 0 10px 28px rgba(218,41,28,0.28);
        }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.9rem;
            font-weight: 800;
        }
        .nav-links a {
            color: var(--muted);
            text-decoration: none;
            transition: color 0.2s, background 0.2s;
        }
        .nav-links a:hover { color: var(--neon); }
        .nav-links .active {
            color: #fff;
            background: #182033;
            padding: 0.62rem 0.9rem;
            border-radius: 8px;
        }
        .nav-menu {
            position: relative;
            padding: 0.75rem 0;
            margin: -0.75rem 0;
        }
        .nav-menu > a {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }
        .nav-menu-panel {
            position: absolute;
            top: 100%;
            left: 0;
            width: 420px;
            display: none;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.25rem;
            padding: 0.75rem;
            background: #111827;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            box-shadow: 0 18px 48px rgba(0,0,0,0.42);
        }
        .nav-menu-panel::before {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: -0.8rem;
            height: 0.8rem;
        }
        .nav-menu:hover .nav-menu-panel,
        .nav-menu:focus-within .nav-menu-panel {
            display: grid;
        }
        .nav-menu-panel a {
            padding: 0.55rem 0.65rem;
            border-radius: 6px;
            color: #d6def5;
            white-space: nowrap;
        }
        .nav-menu-panel a:hover {
            color: var(--neon);
            background: #171c2c;
        }
        .search-bar {
            width: 280px;
            background: #151b2b;
            border: 1px solid rgba(255,255,255,0.08);
            color: #fff;
            border-radius: 999px;
            padding: 10px 16px;
            font-family: 'Urbanist', sans-serif;
            font-size: 0.9rem;
            transition: border-color 0.2s;
        }
        .search-bar:focus {
            outline: none;
            border-color: var(--red);
        }
        .search-button {
            border: none;
            padding: 10px 16px;
            font-family: 'Urbanist', sans-serif;
            font-weight: 900;
            font-size: 0.82rem;
            cursor: pointer;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--red), var(--red-dark));
            color: #fff;
        }
        .account-link {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border: 1px solid rgba(212,175,55,0.26);
            border-radius: 999px;
            padding: 10px 14px;
            color: #fff;
            background: rgba(212,175,55,0.08);
            font-size: 0.85rem;
            font-weight: 900;
            text-decoration: none;
            white-space: nowrap;
        }
        .account-menu { position: relative; }
        .account-icon {
            width: 42px;
            height: 42px;
            border: 1px solid rgba(212,175,55,0.35);
            border-radius: 999px;
            background: rgba(212,175,55,0.08);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            overflow: hidden;
        }
        .account-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .account-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 210px;
            display: none;
            background: #111827;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            box-shadow: 0 18px 48px rgba(0,0,0,0.42);
            overflow: hidden;
        }
        .account-menu:hover .account-dropdown,
        .account-menu:focus-within .account-dropdown { display: block; }
        .account-name {
            padding: 0.85rem 1rem;
            color: #fff;
            font-weight: 900;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .account-dropdown a {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.75rem 1rem;
            color: #d6def5;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 800;
        }
        .account-dropdown a:hover {
            color: var(--neon);
            background: #171c2c;
        }
        .movie-card {
            position: relative;
            overflow: hidden;
            border-radius: 6px;
            aspect-ratio: 2/3;
            cursor: pointer;
            background: #151b2b;
            transition: transform 0.3s ease;
        }
        .movie-card:hover { transform: scale(1.03); }
        .movie-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .movie-card .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 55%);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .movie-card:hover .overlay { opacity: 1; }
        .movie-card .badge {
            position: absolute;
            left: 8px;
            bottom: 8px;
            background: var(--neon);
            color: #111;
            font-size: 0.6rem;
            font-weight: 900;
            padding: 4px 8px;
            border-radius: 4px;
            text-transform: uppercase;
        }
        .movie-card .stat-row,
        .poster-card .stat-row {
            position: absolute;
            left: 0.55rem;
            bottom: 0.55rem;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            max-width: calc(100% - 1.1rem);
        }
        .poster-card .stat-row {
            bottom: 4.7rem;
        }
        .movie-card .stat-pill,
        .poster-card .stat-pill {
            min-width: 42px;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            border-radius: 4px;
            padding: 0.28rem 0.48rem;
            color: #fff;
            font-size: 0.68rem;
            font-weight: 900;
            line-height: 1;
            box-shadow: 0 8px 18px rgba(0,0,0,0.24);
        }
        .movie-card .stat-pill.episode,
        .poster-card .stat-pill.episode {
            background: #4f46e5;
        }
        .movie-card .stat-pill.lang,
        .poster-card .stat-pill.lang {
            background: #10b981;
        }
        .movie-card .info {
            position: absolute;
            bottom: 2rem;
            left: 0;
            right: 0;
            padding: 12px 10px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .movie-card:hover .info { opacity: 1; }
        .movie-card .title {
            font-weight: 900;
            font-size: 0.85rem;
            line-height: 1.2;
            color: #fff;
        }
        .movie-card .sub {
            font-size: 0.72rem;
            color: var(--neon);
            margin-top: 3px;
        }
        .section-title {
            font-size: 1.3rem;
            font-weight: 900;
            letter-spacing: 0;
            text-transform: uppercase;
            color: #fff;
        }
        .section-title span { color: var(--neon); }
        footer {
            background: #070a10;
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 2rem 0;
            text-align: center;
            font-size: 0.8rem;
            color: var(--muted);
        }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #070a10; }
        ::-webkit-scrollbar-thumb { background: #30384f; border-radius: 999px; }
        ::-webkit-scrollbar-thumb:hover { background: #46506b; }
        @@media (max-width: 920px) {
            .nav-inner { gap: 1rem; flex-wrap: wrap; height: auto; padding-top: 0.85rem; padding-bottom: 0.85rem; }
            .nav-links { order: 3; width: 100%; overflow-x: auto; padding-bottom: 0.2rem; }
            .nav-menu-panel { position: fixed; left: 1rem; right: 1rem; width: auto; top: 7rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .search-bar { width: min(48vw, 260px); }
        }
        @@media (max-width: 560px) {
            .nav-inner { align-items: stretch; }
            .nav-inner form { width: 100%; }
            .search-bar { width: 100%; }
        }
    </style>
</head>
<body>
<nav>
    <div class="nav-inner">
        <a href="/" class="logo-text">
            <span class="logo-mark">▶</span>
            <span><span style="color:var(--red);">LVDK</span><span style="color:var(--neon);">MOVIE</span></span>
        </a>
        <div class="nav-links">
            <a class="active" href="/">Trang chủ</a>
            <a href="/danh-sach/phim-moi-cap-nhat">Tất cả</a>
            <a href="/the-loai/hanh-dong">Thể loại</a>
            <div class="nav-menu">
                <a href="/quoc-gia/han-quoc">Quốc gia ▾</a>
                <div class="nav-menu-panel">
                    <a href="/quoc-gia/viet-nam">Việt Nam</a>
                    <a href="/quoc-gia/han-quoc">Hàn Quốc</a>
                    <a href="/quoc-gia/trung-quoc">Trung Quốc</a>
                    <a href="/quoc-gia/nhat-ban">Nhật Bản</a>
                    <a href="/quoc-gia/thai-lan">Thái Lan</a>
                    <a href="/quoc-gia/au-my">Âu Mỹ</a>
                    <a href="/quoc-gia/anh">Anh</a>
                    <a href="/quoc-gia/phap">Pháp</a>
                    <a href="/quoc-gia/dai-loan">Đài Loan</a>
                    <a href="/quoc-gia/hong-kong">Hồng Kông</a>
                    <a href="/quoc-gia/an-do">Ấn Độ</a>
                    <a href="/quoc-gia/canada">Canada</a>
                </div>
            </div>
            <a href="/danh-sach/phim-moi-cap-nhat">Phim mới</a>
            <a href="/danh-sach/phim-bo">Phim bộ</a>
            <a href="/danh-sach/phim-le">Phim lẻ</a>
        </div>
        <div style="margin-left:auto;display:flex;align-items:center;gap:0.7rem;">
            <form method="get" action="/Home/Search" style="display:flex;gap:8px;">
                <input class="search-bar" name="keyword" placeholder="Tìm phim thuyết minh..." />
                <button type="submit" class="search-button">Tìm</button>
            </form>
            @if (string.IsNullOrWhiteSpace(displayName))
            {
                <a class="account-link" href="/Account/Login">Đăng nhập</a>
            }
            else
            {
                <div class="account-menu">
                    <button class="account-icon" type="button" aria-label="Tài khoản">
                        <img src="@avatarUrl" alt="@displayName" />
                    </button>
                    <div class="account-dropdown">
                        <div class="account-name">@displayName</div>
                        <a href="/Account/Favorites"><span aria-hidden="true">&#9829;</span><span>Yêu thích</span></a>
                        <a href="/Account/Logout"><span aria-hidden="true">&#8634;</span><span>Thoát</span></a>
                    </div>
                </div>
            }
        </div>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer>
    <p>© 2026 <span class="neon">LVDKMovie</span> - Phim online thuyết minh, vietsub cập nhật mới.</p>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
